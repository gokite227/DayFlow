# Copy to infra/.env (git-ignored) and set a local-only password.
# docker compose and the API's "local" profile both read these values.
POSTGRES_DB=dayflow
POSTGRES_USER=dayflow
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Google login (infra/README.md "Google Cloud"). Placeholders only: never commit real values.
# Without them the API still starts; only "Google로 계속하기" answers 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional locally (application-local.yml has development defaults):
# DAYFLOW_JWT_SECRET=<at least 32 random bytes>
# DAYFLOW_PUBLIC_BASE_URL=http://localhost:8080
# DAYFLOW_WEB_URL=http://localhost:3000
# DAYFLOW_ALLOWED_WEB_ORIGINS=http://localhost:3000
# DAYFLOW_MOBILE_REDIRECT_URI=dayflow://auth/callback
# Development-only sign-in without Google, for local E2E. Never on a server (the prod profile refuses it).
# DAYFLOW_DEV_LOGIN_ENABLED=true

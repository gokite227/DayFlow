# Copy to apps/mobile/.env.local (git-ignored) and restart `pnpm --filter @dayflow/mobile start`.
# Origin of the DayFlow Spring Boot API. Inlined into the JS bundle at build/start time.
#
# - Android emulator:        http://10.0.2.2:8080
# - iOS simulator:           http://localhost:8080
# - Physical device (same Wi-Fi): http://<your computer LAN IP>:8080   e.g. http://192.168.0.10:8080
#   (localhost on a phone is the phone itself, not your computer)
EXPO_PUBLIC_DAYFLOW_API_BASE_URL=
{
  "name": "@dayflow/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "config:check": "expo config --type public --json",
    "bundle:check": "expo export --platform android --platform ios --output-dir .expo-export-check --no-minify"
  },
  "dependencies": {
    "@dayflow/api-client": "workspace:*",
    "@dayflow/design-tokens": "workspace:*",
    "@dayflow/domain": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "5.102.8",
    "expo": "57.0.22",
    "expo-constants": "57.0.18",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-linking": "57.0.10",
    "expo-notifications": "57.0.18",
    "expo-router": "57.0.21",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "expo": {
    "install": {
      "exclude": ["expo", "expo-notifications", "typescript"]
    }
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}

# Copy to apps/web/.env.local (git-ignored).
# Origin of the DayFlow Spring Boot API used by @dayflow/api-client.
NEXT_PUBLIC_DAYFLOW_API_BASE_URL=http://localhost:8080

# Development only: shows a "개발용 로그인" form that signs in without Google. The API must run with
# DAYFLOW_DEV_LOGIN_ENABLED=true (never on a server). Leave unset for normal Google login.
# NEXT_PUBLIC_DAYFLOW_DEV_LOGIN=true
